    local function LoadIconModule()
        if LoadedIconModule ~= nil then
            return LoadedIconModule or nil
        end

        local Success, Result = pcall(function()
            if not isfile(IconModulePath) then
                writefile(IconModulePath, game:HttpGet(IconModuleSource))
            end

            if readfile then
                return loadstring(readfile(IconModulePath))()
            end

            return loadstring(game:HttpGet(IconModuleSource))()
        end)

        LoadedIconModule = Success and type(Result) == "table" and Result or false
        return LoadedIconModule or nil
    end

    Library.ResolveIcon = function(self, Icon)
        local Fallback = {
            Image = "rbxassetid://109391165290124"
        }

        if Icon == nil then
            return Fallback
        end

        if type(Icon) == "number" then
            return {
                Image = "rbxassetid://" .. tostring(Icon)
            }
        end

        if type(Icon) ~= "string" then
            return Fallback
        end

        if StringFind(Icon, "rbxassetid://") then
            return {
                Image = Icon
            }
        end

        if Icon:match("^%d+$") then
            return {
                Image = "rbxassetid://" .. Icon
            }
        end

        local IconModule = LoadIconModule()
        if IconModule and IconModule.GetIcon then
            local Success, Result = pcall(function()
                return IconModule:GetIcon(Icon)
            end)

            if Success and Result then
                if type(Result) == "string" then
                    return {
                        Image = Result
                    }
                end

                if type(Result) == "table" then
                    local Data = Result[2] or { }
                    return {
                        Image = Result[1] or Data.Image or Fallback.Image,
                        ImageRectSize = Data.ImageRectSize,
                        ImageRectOffset = Data.ImageRectPosition
                    }
                end
            end
        end

        return Fallback
    end

