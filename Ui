    Library.GetIcon = function(self, Icon)
        Icon = tostring(Icon or "")

        local Empty = { Image = "", RectOffset = Vector2New(0, 0), RectSize = Vector2New(0, 0) }

        if Icon == "" then
            return Empty
        end

        if StringFind(Icon, "://") then
            return { Image = Icon, RectOffset = Vector2New(0, 0), RectSize = Vector2New(0, 0) }
        end

        if StringFind(Icon, "^%d+$") then
            return { Image = "rbxassetid://" .. Icon, RectOffset = Vector2New(0, 0), RectSize = Vector2New(0, 0) }
        end

        if StringFind(Icon, "^rbxassetid://") then
            return { Image = Icon, RectOffset = Vector2New(0, 0), RectSize = Vector2New(0, 0) }
        end

        if self.IconCache[Icon] then
            return self.IconCache[Icon]
        end

        local IconData

        if IconModule and IconModule.Icon2 then
            local Ok, Resolved = pcall(IconModule.Icon2, Icon, nil, true)
            if Ok and Resolved then
                if type(Resolved) == "table" then
                    local Meta = Resolved[2] or { }
                    IconData = {
                        Image = Resolved[1] or "",
                        RectSize = Meta.ImageRectSize or Vector2New(0, 0),
                        RectOffset = Meta.ImageRectPosition or Meta.ImageRectOffset or Vector2New(0, 0)
                    }
                elseif type(Resolved) == "string" then
                    IconData = { Image = Resolved, RectOffset = Vector2New(0, 0), RectSize = Vector2New(0, 0) }
                end
            end
        end

        if not IconData then
            local Result
            local Path = self.Folders.Assets .. "/lucide_" .. Icon .. ".png"

            if HasCustomAsset then
                pcall(function()
                    if not isfile(Path) then
                        writefile(Path, game:HttpGet(self.IconSource .. Icon .. ".png"))
                        task.wait()
                    end

                    Result = GetCustomAsset(Path)
                end)
            end

            if not Result or Result == "" then
                Result = self.Icons[Icon] or ""
            end

            IconData = { Image = Result, RectOffset = Vector2New(0, 0), RectSize = Vector2New(0, 0) }
        end

        self.IconCache[Icon] = IconData
        return IconData
    end

