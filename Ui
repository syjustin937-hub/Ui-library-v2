            if SelectorDebounce then
                return
            end

            Page.SelectorOpen = Bool

            SelectorDebounce = true

            if Bool then
                Items["OptionHolder"].Instance.Visible = true
            end

            Items["SelectorIcon"]:Tween(nil, {Rotation = Bool and 180 or 0})

            local Descendants = Items["OptionHolder"].Instance:GetDescendants()
            TableInsert(Descendants, Items["OptionHolder"].Instance)

            local NewTween
            for Index, Value in Descendants do
                local ValueIndex = Library:GetTransparencyPropertyFromItem(Value)

                if not ValueIndex then
                    continue
                end

                for _, Property in ValueIndex do
                    NewTween = Library:FadeItem(Value, Property, Bool, Page.Window.FadeSpeed)
                end
            end

            Library:Connect(NewTween.Tween.Completed, function()
                SelectorDebounce = false
                Items["OptionHolder"].Instance.Visible = Bool
            end)
        end

        function Page:AddSelectorOption(SubPage)
            local Option = Instances:Create("TextButton", {
                Parent = Items["OptionList"].Instance,
                FontFace = Library.Font,
                TextColor3 = FromRGB(255, 255, 255),
                TextTransparency = 0.5,
                Text = SubPage.Name,
                Name = "\0",
                AutoButtonColor = false,
                BorderColor3 = FromRGB(0, 0, 0),
                Size = UDim2New(1, -4, 0, 24),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                BorderSizePixel = 0,
                ZIndex = 25,
                TextSize = 13,
                BackgroundColor3 = FromRGB(27, 27, 30)
            })  Option:AddToTheme({TextColor3 = "Text", BackgroundColor3 = "Background"})

            Instances:Create("UICorner", {
                Parent = Option.Instance,
                CornerRadius = UDimNew(0, 7)
            })

            Instances:Create("UIPadding", {
                Parent = Option.Instance,
                PaddingLeft = UDimNew(0, 8)
            })

            Option:Connect("MouseButton1Down", function()
                for Index, Value in Page.SubPages do
                    Value:Turn(Value == SubPage)
                end

                Page:SetSelectorOpen(false)
            end)

            local Count = #Page.SubPages
            Items["OptionHolder"].Instance.Size = UDim2New(0, 150, 0, MathClamp(Count * 25 + 7, 32, 157))

            return Option
        end

        function Page:SetActiveSubPage(SubPage)
            Items["Title"].Instance.Text = StringFormat("%s / %s", Page.Name, SubPage.Name)
            Items["SelectorValue"].Instance.Text = SubPage.Name

            for Index, Value in Page.SubPages do
                local Option = Value.Items["Option"]

                if not Option then
                    continue
                end

                if Value == SubPage then
                    Option:ChangeItemTheme({TextColor3 = "Accent", BackgroundColor3 = "Background"})
                    Option:Tween(nil, {TextColor3 = Library.Theme.Accent, TextTransparency = 0, BackgroundTransparency = 0})
                else
                    Option:ChangeItemTheme({TextColor3 = "Text", BackgroundColor3 = "Background"})
                    Option:Tween(nil, {TextColor3 = Library.Theme.Text, TextTransparency = 0.5, BackgroundTransparency = 1})
                end
            end
        end

        Items["Selector"]:Connect("MouseButton1Down", function()
            Page:SetSelectorOpen(not Page.SelectorOpen)
        end)

        Library:Connect(UserInputService.InputBegan, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 and Page.SelectorOpen and not SelectorDebounce and not Library:IsMouseOverFrame(Items["OptionHolder"]) and not Library:IsMouseOverFrame(Items["Selector"]) then
                Page:SetSelectorOpen(false)
            end
        end)

        local Debounce = false 

        function Page:Turn(Bool)
            if Debounce then 
                return 
            end

            Page.Active = true

            Debounce = true 

            if Bool then
                Items["PageContent"].Instance.Visible = true
                Items["PageContent"].Instance.Parent = Page.Window.Items["Inline"].Instance
                Items["Inactive"]:Tween(nil, {ImageTransparency = 0})
            else
                Items["Inactive"]:Tween(nil, {ImageTransparency = 0.55})

                if Page.SelectorOpen then
                    Page:SetSelectorOpen(false)
                end
            end

            local Descendants = Items["PageContent"].Instance:GetDescendants()
            TableInsert(Descendants, Items["PageContent"].Instance)

            local NewTween
            for Index, Value in Descendants do 
                local ValueIndex = Library:GetTransparencyPropertyFromItem(Value)

                if not ValueIndex then 
                    continue
                end

                if type(ValueIndex) == "table" then
                    for _, Property in ValueIndex do 
                        NewTween = Library:FadeItem(Value, Property, Bool, Page.Window.FadeSpeed)
                    end
                else
                    NewTween = Library:FadeItem(Value, ValueIndex, Bool, Page.Window.FadeSpeed)
                end
            end

            Library:Connect(NewTween.Tween.Completed, function()
                Debounce = false
                Items["PageContent"].Instance.Visible = Bool
                Items["PageContent"].Instance.Parent = Bool and Page.Window.Items["Inline"].Instance or Library.UnusedHolder.Instance
                Items["Columns"]:Tween(nil, {Position = Bool and UDim2New(0, 0, 0, 66) or UDim2New(0, 0, 1, 0)})
            end)
        end

        Items["Inactive"]:Connect("MouseButton1Down", function()
            for Index, Value in Page.Window.Pages do
                Value:Turn(Value == Page)
            end
        end)

        if #Page.Window.Pages == 0 then 
            Page:Turn(true)
        end

        Page.Items = Items

        TableInsert(Page.Window.Pages, Page)
        return setmetatable(Page, Library.Pages)
    end

