                Name = "\0",
                BorderSizePixel = 0,
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2New(1, 0, 0, 15),
                ZIndex = 4,
                TextSize = 13,
                BackgroundColor3 = FromRGB(255, 255, 255)
            })  Items["Text"]:AddToTheme({TextColor3 = "Text"})

            Items["RealKeybind"] = Instances:Create("TextButton", {
                Parent = Items["Keybind"].Instance,
                AutoButtonColor = false,
                Text = "",
                BorderColor3 = FromRGB(0, 0, 0),
                AnchorPoint = Vector2New(0, 1),
                Name = "\0",
                Position = UDim2New(0, 0, 1, 0),
                Size = UDim2New(1, 0, 0, 26),
                ZIndex = 4,
                BorderSizePixel = 0,
                BackgroundColor3 = FromRGB(38, 38, 43)
            })  Items["RealKeybind"]:AddToTheme({BackgroundColor3 = "Element"})

            Instances:Create("UIStroke", {
                Parent = Items["RealKeybind"].Instance,
                Color = FromRGB(45, 45, 51),
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            }):AddToTheme({Color = "Border"})

            Instances:Create("UICorner", {
                Parent = Items["RealKeybind"].Instance,
                CornerRadius = UDimNew(0, 6)
            })

            Items["Value"] = Instances:Create("TextLabel", {
                Parent = Items["RealKeybind"].Instance,
                FontFace = Library.Fonts.Medium,
                TextColor3 = FromRGB(255, 255, 255),
                BorderColor3 = FromRGB(255, 255, 255),
                Text = "None",
                Name = "\0",
                BorderSizePixel = 0,
                Size = UDim2New(1, -20, 1, 0),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2New(0, 10, 0, 0),
                ZIndex = 4,
                TextSize = 13,
                BackgroundColor3 = FromRGB(255, 255, 255)
            })  Items["Value"]:AddToTheme({TextColor3 = "Text"})
        end

        function Keybind:Get()
            return Keybind.Toggled, Keybind.Key
        end

        function Keybind:SetVisibility(Bool)
            Items["Keybind"].Instance.Visible = Bool
        end

        function Keybind:Set(Key)
            local NewKey, NewMode

            if type(Key) == "table" then
                NewKey = Key.Key or Key.key
                NewMode = Key.Mode or Key.mode
            elseif TableFind(ModeList, Key) then
                NewMode = Key
            else
                NewKey = Key
            end

            if NewMode then
                Keybind:SetMode(NewMode, true)
            end

            if NewKey ~= nil then
                Keybind.Key = ResolveKey(NewKey)
                Keybind.Value = DisplayKey(Keybind.Key)

                Items["Value"].Instance.Text = Keybind.Value
            end

            Keybind.Picking = false

            Items["Value"]:ChangeItemTheme({TextColor3 = "Text"})
            Items["Value"]:Tween(nil, {TextColor3 = Library.Theme.Text})

            Library.Flags[Keybind.Flag] = {
                Mode = Keybind.Mode,
                Key = Keybind.Key,
                Toggled = Keybind.Toggled
            }

            if Keybind.Callback then
                Library:SafeCall(Keybind.Callback, Keybind.Toggled)
            end
        end

        function Keybind:SetMode(Mode, Silent)
            Keybind.Mode = Mode or Keybind.Mode

            if Keybind.Mode == "Always" then
                Keybind.Toggled = true
            else
                Keybind.Toggled = false
            end

            Library.Flags[Keybind.Flag] = {
                Mode = Keybind.Mode,
                Key = Keybind.Key,
                Toggled = Keybind.Toggled
            }

            if not Silent and Keybind.Callback then
                Library:SafeCall(Keybind.Callback, Keybind.Toggled)
            end
        end

        function Keybind:Press(Bool)
            if Keybind.Mode == "Toggle" then
                Keybind.Toggled = not Keybind.Toggled
            elseif Keybind.Mode == "Hold" then
                Keybind.Toggled = Bool
            elseif Keybind.Mode == "Always" then
                Keybind.Toggled = true
            end

            Library.Flags[Keybind.Flag] = {
                Mode = Keybind.Mode,
                Key = Keybind.Key,
                Toggled = Keybind.Toggled
            }

            if Keybind.Callback then
                Library:SafeCall(Keybind.Callback, Keybind.Toggled)
            end
        end

        local PickConnection
        local PickedAt = 0

        local StopPicking = function()
            if PickConnection then
                PickConnection:Disconnect()
                PickConnection = nil
            end

            PickedAt = os.clock()
            Keybind.Picking = false
        end

        local StartPicking = function()
            Keybind.Picking = true

            Items["Value"].Instance.Text = "Press any key..."
            Items["Value"]:ChangeItemTheme({TextColor3 = "Accent"})
            Items["Value"]:Tween(nil, {TextColor3 = Library.Theme.Accent})

            PickConnection = UserInputService.InputBegan:Connect(function(Input)
                if Input.UserInputType == Enum.UserInputType.Touch then
                    return
                end

                if Input.KeyCode == Enum.KeyCode.Escape then
                    StopPicking()
                    Keybind:Set(Keybind.Key)
                    return
                end

                if Input.KeyCode == Enum.KeyCode.Backspace or Input.KeyCode == Enum.KeyCode.Delete then
                    StopPicking()
                    Keybind:Set("None")
                    return
                end

                if Input.UserInputType == Enum.UserInputType.MouseButton1 and Library:IsMouseOverFrame(Items["RealKeybind"]) then
                    StopPicking()
                    Keybind:Set(Keybind.Key)
                    return
                end

                if not IsBindableInput(Input) then
                    return
                end

                StopPicking()

                if Input.UserInputType == Enum.UserInputType.Keyboard then
                    Keybind:Set(Input.KeyCode)
                else
                    Keybind:Set(Input.UserInputType)
                end
            end)
        end

        Items["RealKeybind"]:Connect("MouseButton1Click", function()
            if os.clock() - PickedAt < 0.25 then
                return
            end

            if Keybind.Picking then
                StopPicking()
                Keybind:Set(Keybind.Key)
                return
            end

            StartPicking()
        end)

        Library:Connect(UserInputService.InputBegan, function(Input, Gpe)
            if Gpe or Keybind.Picking or Keybind.Key == "None" then
                return
            end

            if tostring(Input.KeyCode) ~= Keybind.Key and tostring(Input.UserInputType) ~= Keybind.Key then
                return
            end

            if Keybind.Mode == "Toggle" then
                Keybind:Press()
            elseif Keybind.Mode == "Hold" then
                Keybind:Press(true)
            end
        end)

        Library:Connect(UserInputService.InputEnded, function(Input)
            if Keybind.Key == "None" or Keybind.Mode ~= "Hold" then
                return
            end

            if tostring(Input.KeyCode) ~= Keybind.Key and tostring(Input.UserInputType) ~= Keybind.Key then
                return
            end

            Keybind:Press(false)
        end)

        if Keybind.Default ~= nil then
            Keybind:Set({Key = Keybind.Default, Mode = Keybind.Mode or "Toggle"})
        else
            Keybind:Set("None")
        end

        Library.SetFlags[Keybind.Flag] = function(Value)
            Keybind:Set(Value)
        end

        return Keybind
    end

