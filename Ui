            local Path = Library.Folders.Assets .. "/" .. Family .. ".json"

            if not isfile(Path) then
                local Assets = {
                    Book = self:Fetch("Book"),
                    Heavy = self:Fetch("Heavy")
                }

                local Built = { }

                for Index, Face in Faces do
                    TableInsert(Built, {
                        name = Face[1],
                        weight = Face[2],
                        style = "normal",
                        assetId = Assets[Face[3]]
                    })
                end

                writefile(Path, HttpService:JSONEncode({ name = Family, faces = Built }))
            end

            return GetCustomAsset(Path)
        end

        local Ok, Resolved = pcall(function()
            if not HasCustomAsset then
                return nil
            end

            return CustomFont:Build()
        end)

        local Source = Ok and Resolved or nil

        function CustomFont:Get(Weight)
            if Source then
                local Loaded, Result = pcall(Font.new, Source, Enum.FontWeight[Weight])

                if Loaded and Result then
                    return Result
                end
            end

            local Loaded, Result = pcall(Font.fromEnum, Fallbacks[Weight])

            if Loaded and Result then
                return Result
            end

            return Font.new("rbxasset://fonts/families/SourceSansPro.json")
        end

        Library.Fonts = {
            Regular = CustomFont:Get("Bold"),
            Medium = CustomFont:Get("Bold"),
            SemiBold = CustomFont:Get("Bold"),
            Bold = CustomFont:Get("Bold")
        }

        Library.Font = Library.Fonts.Bold
        Library.BoldFont = Library.Fonts.Bold
    end

    
