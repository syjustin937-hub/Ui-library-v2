                SubItems["KeyPadding"] = Instances:Create("UIPadding", {
                    Parent = SubItems["KeyButton"].Instance,
                    PaddingLeft = UDimNew(0, 6),
                    PaddingRight = UDimNew(0, 6)
                }) 

                local KeyIconData = Library:GetIcon("database")
                SubItems["KeyIcon"] = Instances:Create("ImageLabel", {
                    Parent = SubItems["KeyButton"].Instance,
                    ScaleType = Enum.ScaleType.Fit,
                    BorderColor3 = FromRGB(0, 0, 0),
                    Name = "\0",
                    Size = UDim2New(0, 12, 0, 12),
                    AnchorPoint = Vector2New(0.5, 0.5),
                    Image = KeyIconData.Image,
                    ImageRectOffset = KeyIconData.RectOffset,
                    ImageRectSize = KeyIconData.RectSize,
                    BackgroundTransparency = 1,
                    Position = UDim2New(0.5, 0, 0.5, 0),
                    ZIndex = 6,
                    BorderSizePixel = 0,
                    BackgroundColor3 = FromRGB(255, 255, 255)
                })  SubItems["KeyIcon"]:AddToTheme({ImageColor3 = "Image"})

                Instances:Create("UISizeConstraint", {
                    Parent = SubItems["KeyButton"].Instance,
                    MinSize = Vector2New(24, 16)
                }) 

                local CalculateCount = function(Index)
                    local MaxButtonsAdded = 5

                    local Column = Index % MaxButtonsAdded
                
                    local ButtonSize = SubItems["KeyButton"].Instance.AbsoluteSize
                    local Spacing = 4
                
                    local XPosition = (ButtonSize.X + Spacing) * Column - Spacing - ButtonSize.X
                
                    SubItems["KeyButton"].Instance.Position = UDim2New(1, Index == 1 and -XPosition - 38 or -XPosition, 0.5, 0)

                    Toggle.Reserved = 38 + (ButtonSize.X + 6) * Index
                    Toggle:FitText()
                end

                CalculateCount(Keybind.Count)

                
                Library:Connect(SubItems["KeyButton"].Instance:GetPropertyChangedSignal("AbsoluteSize"), function()
                    CalculateCount(Keybind.Count)
                end)

                task.defer(function()
                    CalculateCount(Keybind.Count)
                end)
                
                function Keybind:Get()
                    return Keybind.Toggled, Keybind.Key
                end

                function Keybind:SetVisibility(Bool)
                    SubItems["KeyButton"].Instance.Visible = Bool
                end

                function Keybind:Set(Key)
                    local NewKey, NewMode

                    if type(Key) == "table" then
                        NewKey = Key.Key or Key.key
                        NewMode = Key.Mode or Key.mode
                    elseif TableFind(ModeList, Key) then
                        NewMode = Key
                    else
                        NewKey = Key
                    end

                    if NewMode then
                        Keybind:SetMode(NewMode, true)
                    end

                    if NewKey ~= nil then
                        Keybind.Key = ResolveKey(NewKey)
                        Keybind.Value = DisplayKey(Keybind.Key)

                        local Unbound = Keybind.Key == "None"
                        local ShortKey = (not Unbound) and (type(Keybind.Value) == "string") and (#Keybind.Value <= 2)

                        SubItems["KeyButton"].Instance.Text = Unbound and "" or Keybind.Value
                        SubItems["KeyIcon"].Instance.Visible = Unbound
                        SubItems["KeyButton"]:Tween(nil, {TextTransparency = Unbound and 1 or 0})
                        if Unbound or ShortKey then
                            SubItems["KeyButton"].Instance.AutomaticSize = Enum.AutomaticSize.None
                            SubItems["KeyButton"].Instance.Size = UDim2New(0, 24, 0, 16)
                            SubItems["KeyPadding"].Instance.PaddingLeft = UDimNew(0, 0)
                            SubItems["KeyPadding"].Instance.PaddingRight = UDimNew(0, 0)
                        else
                            SubItems["KeyButton"].Instance.AutomaticSize = Enum.AutomaticSize.X
                            SubItems["KeyButton"].Instance.Size = UDim2New(0, 0, 0, 16)
                            SubItems["KeyPadding"].Instance.PaddingLeft = UDimNew(0, 6)
                            SubItems["KeyPadding"].Instance.PaddingRight = UDimNew(0, 6)
                        end
                    end

                    Keybind.Picking = false

                    SubItems["KeyButton"]:ChangeItemTheme({TextColor3 = "Text"})
                    SubItems["KeyButton"]:Tween(nil, {TextColor3 = Library.Theme.Text})
                    SubItems["KeyIcon"]:ChangeItemTheme({ImageColor3 = "Image"})
                    SubItems["KeyIcon"]:Tween(nil, {ImageColor3 = Library.Theme.Image})

                    Library.Flags[Keybind.Flag] = {
                        Mode = Keybind.Mode,
                        Key = Keybind.Key,
                        Toggled = Keybind.Toggled
                    }

                    if Keybind.Callback then
                        Library:SafeCall(Keybind.Callback, Keybind.Toggled)
                    end
                end

                function Keybind:SetMode(Mode, Silent)
                    Keybind.Mode = Mode or Keybind.Mode

                    if Keybind.Mode == "Always" then
                        Keybind.Toggled = true
                    else
                        Keybind.Toggled = false
                    end

                    Library.Flags[Keybind.Flag] = {
                        Mode = Keybind.Mode,
                        Key = Keybind.Key,
                        Toggled = Keybind.Toggled
                    }

                    if not Silent and Keybind.Callback then
                        Library:SafeCall(Keybind.Callback, Keybind.Toggled)
                    end
                end

                function Keybind:Press(Bool)
                    if Keybind.Mode == "Toggle" then
                        Keybind.Toggled = not Keybind.Toggled
                    elseif Keybind.Mode == "Hold" then
                        Keybind.Toggled = Bool
                    elseif Keybind.Mode == "Always" then
                        Keybind.Toggled = true
                    end

                    Toggle:Set(nil, Keybind)

                    Library.Flags[Keybind.Flag] = {
                        Mode = Keybind.Mode,
                        Key = Keybind.Key,
                        Toggled = Keybind.Toggled
                    }

                    if Keybind.Callback then
                        Library:SafeCall(Keybind.Callback, Keybind.Toggled)
                    end
                end

                local PickConnection
                local PickedAt = 0

                local StopPicking = function()
                    if PickConnection then
                        PickConnection:Disconnect()
                        PickConnection = nil
                    end

                    PickedAt = os.clock()
                    Keybind.Picking = false
                end

                local StartPicking = function()
                    Keybind.Picking = true

                    SubItems["KeyIcon"].Instance.Visible = true
                    SubItems["KeyButton"].Instance.Text = ""
                    SubItems["KeyButton"]:Tween(nil, {TextTransparency = 1})
                    SubItems["KeyButton"].Instance.AutomaticSize = Enum.AutomaticSize.None
                    SubItems["KeyButton"].Instance.Size = UDim2New(0, 24, 0, 16)
                    SubItems["KeyPadding"].Instance.PaddingLeft = UDimNew(0, 0)
                    SubItems["KeyPadding"].Instance.PaddingRight = UDimNew(0, 0)
                    SubItems["KeyIcon"]:ChangeItemTheme({ImageColor3 = "Muted"})
                    SubItems["KeyIcon"]:Tween(nil, {ImageColor3 = Library.Theme.Muted})

                    PickConnection = UserInputService.InputBegan:Connect(function(Input)
                        if Input.UserInputType == Enum.UserInputType.Touch then
                            return
                        end

                        if Input.KeyCode == Enum.KeyCode.Escape then
                            StopPicking()
                            Keybind:Set(Keybind.Key)
                            return
                        end

                        if Input.KeyCode == Enum.KeyCode.Backspace or Input.KeyCode == Enum.KeyCode.Delete then
                            StopPicking()
                            Keybind:Set("None")
                            return
                        end

                        if Input.UserInputType == Enum.UserInputType.MouseButton1 and Library:IsMouseOverFrame(SubItems["KeyButton"]) then
                            StopPicking()
                            Keybind:Set(Keybind.Key)
                            return
                        end

                        if not IsBindableInput(Input) then
                            return
                        end

                        StopPicking()

                        if Input.UserInputType == Enum.UserInputType.Keyboard then
                            Keybind:Set(Input.KeyCode)
                        else
                            Keybind:Set(Input.UserInputType)
                        end
                    end)
                end

                SubItems["KeyButton"]:Connect("MouseButton1Click", function()
                    if os.clock() - PickedAt < 0.25 then
                        return
                    end

                    if Keybind.Picking then
                        StopPicking()
                        Keybind:Set(Keybind.Key)
                        return
                    end

                    StartPicking()
                end)

                Library:Connect(UserInputService.InputBegan, function(Input, Gpe)
                    if Gpe or Keybind.Picking or Keybind.Key == "None" then
                        return
                    end

                    if tostring(Input.KeyCode) ~= Keybind.Key and tostring(Input.UserInputType) ~= Keybind.Key then
                        return
                    end

                    if Keybind.Mode == "Toggle" then
                        Keybind:Press()
                    elseif Keybind.Mode == "Hold" then
                        Keybind:Press(true)
                    end
                end)

                Library:Connect(UserInputService.InputEnded, function(Input)
                    if Keybind.Key == "None" or Keybind.Mode ~= "Hold" then
                        return
                    end

                    if tostring(Input.KeyCode) ~= Keybind.Key and tostring(Input.UserInputType) ~= Keybind.Key then
                        return
                    end

                    Keybind:Press(false)
                end)

                if Keybind.Default ~= nil then
                    Keybind:Set({Key = Keybind.Default, Mode = Keybind.Mode or "Toggle"})
                else
                    Keybind:Set("None")
                end

                Library.SetFlags[Keybind.Flag] = function(Value)
                    Keybind:Set(Value)
                end

                return Keybind
            end
        end

        Items["Toggle"]:Connect("MouseButton1Down", function()
            Toggle:Set(not Toggle.Value)
        end)

        if Toggle.Default then 
            Toggle:Set(Toggle.Default)
        end

        Library.SetFlags[Toggle.Flag] = function(Value)
            Toggle:Set(Value)
        end

        return Toggle
    end

