        local Debounce = false

        local function CountItems()
            local Count = 0
            for _ in ipairs(Dropdown.Items) do
                Count += 1
            end
            return Count
        end

        local function SyncValueText()
            if Dropdown.Multi then
                local Current = Dropdown.Value or { }
                Items["Value"].Instance.Text = #Current > 0 and TableConcat(Current, ", ") or "None"
            else
                Items["Value"].Instance.Text = Dropdown.Value ~= nil and tostring(Dropdown.Value) or "None"
            end
        end

        function Dropdown:UpdateSize()
            local Count = CountItems()
            Items["OptionHolder"].Instance.Size = UDim2New(1, 0, 0, MathClamp((Count * 23) + 7, 33, Dropdown.MaxSize))
            if Dropdown.IsOpen then
                Items["RealDropdown"].Instance.Size = UDim2New(1, 0, 0, 20 + Items["OptionHolder"].Instance.Size.Y.Offset)
                Items["Dropdown"].Instance.Size = UDim2New(1, 0, 0, 34 + Items["OptionHolder"].Instance.Size.Y.Offset)
            end
        end

        function Dropdown:Remove(Option)
            Option = tostring(Option)

            local Existing = Dropdown.Options[Option]
            if Existing then
                Existing.Button:Clean()
                Dropdown.Options[Option] = nil
            end

            for Index, Value in ipairs(Dropdown.Items) do
                if tostring(Value) == Option then
                    TableRemove(Dropdown.Items, Index)
                    break
                end
            end

            if Dropdown.Multi and type(Dropdown.Value) == "table" then
                local SelectedIndex = TableFind(Dropdown.Value, Option)
                if SelectedIndex then
                    TableRemove(Dropdown.Value, SelectedIndex)
                end
            elseif Dropdown.Value == Option then
                Dropdown.Value = nil
            end

            Library.Flags[Dropdown.Flag] = Dropdown.Value
            SyncValueText()
            Dropdown:UpdateSize()
        end

        function Dropdown:Refresh(List)
            Dropdown.Items = { }

            for _, Value in Dropdown.Options do
                Value.Button:Clean()
            end

            Dropdown.Options = { }
            Dropdown.BuiltOptions = false
            Dropdown.Value = Dropdown.Multi and { } or nil
            Library.Flags[Dropdown.Flag] = Dropdown.Value

            for _, Value in ipairs(List or { }) do
                TableInsert(Dropdown.Items, tostring(Value))
            end

            SyncValueText()
            Dropdown:UpdateSize()
        end

        function Dropdown:Add(Option)
            Option = tostring(Option)
            TableInsert(Dropdown.Items, Option)

            if not Dropdown.BuiltOptions then
                Dropdown:UpdateSize()
                return nil
            end

            local OptionButton = Instances:Create("TextButton", {
                Parent = Items["Holder"].Instance,
                FontFace = Library.Fonts.Medium,
                TextColor3 = FromRGB(255, 255, 255),
                TextTransparency = 0.5,
                Text = Option,
                Name = "␀",
                AutoButtonColor = false,
                BorderColor3 = FromRGB(0, 0, 0),
                Size = UDim2New(1, -5, 0, 20),
                BackgroundTransparency = 1,
                TextXAlignment = Enum.TextXAlignment.Left,
                BorderSizePixel = 0,
                ZIndex = 25,
                TextSize = 12,
                BackgroundColor3 = FromRGB(38, 38, 43)
            })  OptionButton:AddToTheme({TextColor3 = "Text", BackgroundColor3 = "Element"})

            Instances:Create("UICorner", {
                Parent = OptionButton.Instance,
                CornerRadius = UDimNew(0, 5)
            })

            local UIPadding = Instances:Create("UIPadding", {
                Parent = OptionButton.Instance,
                PaddingLeft = UDimNew(0, 9)
            })

            local OptionData = {
                Name = Option,
                Button = OptionButton,
                Padding = UIPadding,
                Selected = false
            }

            function OptionData:Toggle(Status)
                if Status == "Active" then
                    OptionData.Button:ChangeItemTheme({TextColor3 = "Accent"})
                    OptionData.Button:Tween(nil, {TextColor3 = Library.Theme.Accent, BackgroundTransparency = 0, TextTransparency = 0})
                    UIPadding:Tween(nil, {PaddingLeft = UDimNew(0, 14)})
                else
                    OptionData.Button:ChangeItemTheme({TextColor3 = "Text"})
                    OptionData.Button:Tween(nil, {TextColor3 = Library.Theme.Text, BackgroundTransparency = 1, TextTransparency = 0.5})
                    UIPadding:Tween(nil, {PaddingLeft = UDimNew(0, 9)})
                end
            end

            function OptionData:Set()
                OptionData.Selected = not OptionData.Selected

                if Dropdown.Multi then
                    local Index = TableFind(Dropdown.Value, OptionData.Name)

                    if Index then
                        TableRemove(Dropdown.Value, Index)
                    else
                        TableInsert(Dropdown.Value, OptionData.Name)
                    end

                    Library.Flags[Dropdown.Flag] = Dropdown.Value
                    OptionData:Toggle(Index and "Inactive" or "Active")
                    SyncValueText()
                else
                    if OptionData.Selected then
                        Dropdown.Value = OptionData.Name
                        OptionData:Toggle("Active")
                        Items["Value"].Instance.Text = OptionData.Name
                        Library.Flags[Dropdown.Flag] = Dropdown.Value

                        for _, Value in Dropdown.Options do
                            if Value ~= OptionData then
                                Value.Selected = false
                                Value:Toggle("Inactive")
                            end
                        end
                    else
                        Dropdown.Value = nil
                        OptionData:Toggle("Inactive")
                        Items["Value"].Instance.Text = "None"
                        Library.Flags[Dropdown.Flag] = Dropdown.Value
                    end
                end

                if Data.Callback then
                    Library:SafeCall(Data.Callback, Dropdown.Value)
                end
            end

            OptionData.Button:OnHover(function()
                if OptionData.Selected then
                    return
                end

                OptionData.Button:Tween(nil, {TextTransparency = 0.15})
            end)

            OptionData.Button:OnHoverLeave(function()
                if OptionData.Selected then
                    return
                end

                OptionData.Button:Tween(nil, {TextTransparency = 0.5})
            end)

            OptionData.Button:Connect("MouseButton1Down", function()
                OptionData:Set()
            end)

            Dropdown.Options[Option] = OptionData
            Dropdown:UpdateSize()

            return OptionData
        end

        local function EnsureOptionsBuilt()
            if Dropdown.BuiltOptions then
                return
            end

            Dropdown.BuiltOptions = true

            local RawItems = TableClone(Dropdown.Items)
            Dropdown.Items = { }

            for _, Value in ipairs(RawItems) do
                Dropdown:Add(Value)
            end

            if Dropdown.Multi then
                for _, Value in Dropdown.Options do
                    Value.Selected = false
                    Value:Toggle("Inactive")
                end

                for _, Value in ipairs(Dropdown.Value or { }) do
                    local OptionData = Dropdown.Options[Value]
                    if OptionData then
                        OptionData.Selected = true
                        OptionData:Toggle("Active")
                    end
                end
            else
                for _, Value in Dropdown.Options do
                    local Active = Dropdown.Value ~= nil and Value.Name == Dropdown.Value
                    Value.Selected = Active
                    Value:Toggle(Active and "Active" or "Inactive")
                end
            end

            Dropdown:UpdateSize()
        end

        function Dropdown:Set(Option)
            EnsureOptionsBuilt()

            if Dropdown.Multi then
                if type(Option) ~= "table" then
                    return
                end

                for _, Value in Dropdown.Options do
                    Value.Selected = false
                    Value:Toggle("Inactive")
                end

                Dropdown.Value = TableClone(Option)
                Library.Flags[Dropdown.Flag] = Dropdown.Value

                for _, Value in ipairs(Option) do
                    local OptionData = Dropdown.Options[tostring(Value)]
                    if OptionData then
                        OptionData.Selected = true
                        OptionData:Toggle("Active")
                    end
                end

                SyncValueText()
            else
                local OptionData = Dropdown.Options[tostring(Option)]

                if not OptionData then
                    return
                end

                OptionData.Selected = true
                OptionData:Toggle("Active")

                Dropdown.Value = OptionData.Name
                Library.Flags[Dropdown.Flag] = Dropdown.Value

                for _, Value in Dropdown.Options do
                    if Value ~= OptionData then
                        Value.Selected = false
                        Value:Toggle("Inactive")
                    end
                end

                Items["Value"].Instance.Text = Dropdown.Value
            end

            if Data.Callback then
                Library:SafeCall(Data.Callback, Dropdown.Value)
            end
        end

        function Dropdown:SetVisibility(Bool)
            Items["Dropdown"].Instance.Visible = Bool
        end

        function Dropdown:SetOpen(Bool)
            if Debounce then
                return
            end

            if Bool then
                EnsureOptionsBuilt()
            end

            Dropdown.IsOpen = Bool
            Debounce = true

            if Bool then
                Items["OptionHolder"].Instance.Visible = true
            end

            local Descendants = Items["OptionHolder"].Instance:GetDescendants()
            TableInsert(Descendants, Items["OptionHolder"].Instance)

            local NewTween
            for _, Value in Descendants do
                local ValueIndex = Library:GetTransparencyPropertyFromItem(Value)

                if not ValueIndex then
                    continue
                end

                if type(ValueIndex) == "table" then
                    for _, Property in ValueIndex do
                        NewTween = Library:FadeItem(Value, Property, Bool, Dropdown.Window.FadeSpeed)
                    end
                else
                    NewTween = Library:FadeItem(Value, ValueIndex, Bool, Dropdown.Window.FadeSpeed)
                end
            end

            local OptionHeight = Items["OptionHolder"].Instance.Size.Y.Offset
            local SizeTween = Items["RealDropdown"]:Tween(nil, {Size = UDim2New(1, 0, 0, Bool and (20 + OptionHeight) or 20)})
            Items["Dropdown"]:Tween(nil, {Size = UDim2New(1, 0, 0, Bool and (34 + OptionHeight) or 34)})

            local CompletionTween = (NewTween and NewTween.Tween) and NewTween or SizeTween
            if CompletionTween and CompletionTween.Tween then
                Library:Connect(CompletionTween.Tween.Completed, function()
                    Debounce = false
                    Items["OptionHolder"].Instance.Visible = Bool
                end)
            else
                Debounce = false
                Items["OptionHolder"].Instance.Visible = Bool
            end
        end

        Items["RealDropdown"]:OnHover(function()
            Items["RealDropdown"]:Tween(nil, {BackgroundColor3 = Library:Hover()})
        end)

        Items["RealDropdown"]:OnHoverLeave(function()
            Items["RealDropdown"]:Tween(nil, {BackgroundColor3 = Library.Theme.Element})
        end)

        Items["RealDropdown"]:Connect("MouseButton1Down", function()
            Dropdown:SetOpen(not Dropdown.IsOpen)
        end)

        Library:Connect(UserInputService.InputBegan, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 and Dropdown.IsOpen and not Debounce and not Library:IsMouseOverFrame(Items["OptionHolder"]) then
                Dropdown:SetOpen(false)
            end
        end)

        Dropdown:UpdateSize()

        if Dropdown.Default ~= nil then
            if Dropdown.Multi then
                Dropdown.Value = type(Dropdown.Default) == "table" and TableClone(Dropdown.Default) or { }
            else
                Dropdown.Value = tostring(Dropdown.Default)
            end

            Library.Flags[Dropdown.Flag] = Dropdown.Value
            SyncValueText()

            if Data.Callback then
                Library:SafeCall(Data.Callback, Dropdown.Value)
            end
        else
            Library.Flags[Dropdown.Flag] = Dropdown.Value
        end

        Library.SetFlags[Dropdown.Flag] = function(Value)
            Dropdown:Set(Value)
        end

        return Dropdown
    end

