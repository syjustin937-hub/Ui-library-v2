    Library.Watermark = function(self, Data)
        Data = Data or { }

        local Watermark = {
            Entries = Data.Entries or Data.entries or { "Library" },
            Spacing = Data.Spacing or Data.spacing or 18,
            Refresh = Data.Refresh or Data.refresh or 0.5,
            Position = Data.Position or Data.position or UDim2New(1, -15, 0, 15),

            Labels = { },
            Items = { },

            Visible = true
        }

        local Items = { } do
            Items["Watermark"] = Instances:Create("Frame", {
                Parent = Library.Holder.Instance,
                Name = "\0",
                BorderColor3 = FromRGB(0, 0, 0),
                AnchorPoint = Vector2New(1, 0),
                Position = Watermark.Position,
                Size = UDim2New(0, 0, 0, 34),
                AutomaticSize = Enum.AutomaticSize.X,
                ZIndex = 2,
                BorderSizePixel = 0,
                BackgroundColor3 = FromRGB(22, 22, 24)
            })  Items["Watermark"]:AddToTheme({BackgroundColor3 = "Inline"})

            Instances:Create("UICorner", {
                Parent = Items["Watermark"].Instance,
                CornerRadius = UDimNew(0, 8)
            })

            Instances:Create("UIStroke", {
                Parent = Items["Watermark"].Instance,
                Color = FromRGB(46, 46, 50),
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            }):AddToTheme({Color = "Border"})

            Instances:Create("UIPadding", {
                Parent = Items["Watermark"].Instance,
                PaddingLeft = UDimNew(0, 14),
                PaddingRight = UDimNew(0, 14)
            })

            Instances:Create("UIListLayout", {
                Parent = Items["Watermark"].Instance,
                Padding = UDimNew(0, Watermark.Spacing),
                FillDirection = Enum.FillDirection.Horizontal,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                SortOrder = Enum.SortOrder.LayoutOrder
            })
        end

        local function Resolve(Entry)
            if type(Entry) == "function" then
                local Success, Result = pcall(Entry)
                return Success and tostring(Result) or "--"
            end

            return tostring(Entry)
        end

        function Watermark:Update()
            for Index, Entry in Watermark.Entries do
                local Label = Watermark.Labels[Index]

                if not Label then
                    Label = Instances:Create("TextLabel", {
                        Parent = Items["Watermark"].Instance,
                        FontFace = Library.Font,
                        TextColor3 = FromRGB(255, 255, 255),
                        Text = "",
                        Name = "\0",
                        LayoutOrder = Index,
                        Size = UDim2New(0, 0, 1, 0),
                        AutomaticSize = Enum.AutomaticSize.X,
                        BackgroundTransparency = 1,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        BorderColor3 = FromRGB(0, 0, 0),
                        BorderSizePixel = 0,
                        ZIndex = 2,
                        TextSize = 13,
                        BackgroundColor3 = FromRGB(255, 255, 255)
                    })  Label:AddToTheme({TextColor3 = "Text"})

                    Watermark.Labels[Index] = Label
                end

                Label.Instance.Text = Resolve(Entry)
                Label.Instance.Visible = true
            end

            for Index = #Watermark.Entries + 1, #Watermark.Labels do
                Watermark.Labels[Index].Instance.Visible = false
            end
        end

        function Watermark:Set(Entries)
            if type(Entries) == "table" then
                Watermark.Entries = Entries
            end

            Watermark:Update()
        end

        function Watermark:SetEntry(Index, Value)
            Watermark.Entries[Index] = Value
            Watermark:Update()
        end

        local Debounce = false

        function Watermark:SetVisibility(Bool)
            if Debounce then
                return
            end

            Watermark.Visible = Bool

            Debounce = true

            if Bool then
                Items["Watermark"].Instance.Visible = true
            end

            local Descendants = Items["Watermark"].Instance:GetDescendants()
            TableInsert(Descendants, Items["Watermark"].Instance)

            local NewTween
            for Index, Value in Descendants do
                local ValueIndex = Library:GetTransparencyPropertyFromItem(Value)

                if not ValueIndex then
                    continue
                end

                for _, Property in ValueIndex do
                    NewTween = Library:FadeItem(Value, Property, Bool, 0.2)
                end
            end

            Library:Connect(NewTween.Tween.Completed, function()
                Debounce = false
                Items["Watermark"].Instance.Visible = Bool
            end)
        end

        Watermark:Update()

        Library:Thread(function()
            while task.wait(Watermark.Refresh) do
                if not Items["Watermark"].Instance.Parent then
                    break
                end

                Watermark:Update()
            end
        end)

        Watermark.Items = Items

        return Watermark
    end

