        function RangeSlider:Get()
            return RangeSlider.Value.Min, RangeSlider.Value.Max
        end

        function RangeSlider:Set(MinValue, MaxValue)
            if type(MinValue) == "table" then
                MaxValue = MinValue.Max or MinValue[2]
                MinValue = MinValue.Min or MinValue[1]
            end

            MinValue = MathClamp(Library:Round(MinValue or RangeSlider.Value.Min, RangeSlider.Decimals), RangeSlider.Min, RangeSlider.Max)
            MaxValue = MathClamp(Library:Round(MaxValue or RangeSlider.Value.Max, RangeSlider.Decimals), RangeSlider.Min, RangeSlider.Max)

            if MinValue > MaxValue then
                MinValue, MaxValue = MaxValue, MinValue
            end

            RangeSlider.Value = { Min = MinValue, Max = MaxValue }
            Library.Flags[RangeSlider.Flag] = RangeSlider.Value

            local Range = RangeSlider.Max - RangeSlider.Min
            local MinScale = (MinValue - RangeSlider.Min) / Range
            local MaxScale = (MaxValue - RangeSlider.Min) / Range

            local ActiveScale = MaxScale - MinScale

            Items["Accent"]:Tween(TweenInfo.new(0.1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2New(MinScale, 0, 0, 0),
                Size = UDim2New(ActiveScale, 0, 1, 0)
            })
            Items["Shadow"]:Tween(TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {ImageTransparency = 1})

            Items["Value"].Instance.Text = StringFormat("%s%s - %s%s", tostring(MinValue), RangeSlider.Suffix, tostring(MaxValue), RangeSlider.Suffix)

            if RangeSlider.Callback then
                Library:SafeCall(RangeSlider.Callback, MinValue, MaxValue)
            end
        end

        function RangeSlider:SetVisibility(Bool)
            Items["RangeSlider"].Instance.Visible = Bool
        end

        local function GetValue(Input)
            local RelativeX = Input.Position.X - Items["RealSlider"].Instance.AbsolutePosition.X
            local Scale = MathClamp(RelativeX / Items["RealSlider"].Instance.AbsoluteSize.X, 0, 1)

            return ((RangeSlider.Max - RangeSlider.Min) * Scale) + RangeSlider.Min
        end

        local function UpdateSlider(Input)
            if not RangeSlider.Dragging then
                return
            end

            local Value = Library:Round(GetValue(Input), RangeSlider.Decimals)

            if RangeSlider.Dragging == "Min" then
                RangeSlider:Set(Value, RangeSlider.Value.Max)
            else
                RangeSlider:Set(RangeSlider.Value.Min, Value)
            end
        end

        local function StartDragging(Input, Side)
            if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            if not Side then
                local Value = GetValue(Input)
                Side = MathAbs(Value - RangeSlider.Value.Min) <= MathAbs(Value - RangeSlider.Value.Max) and "Min" or "Max"
            end

            RangeSlider.Dragging = Side
            UpdateSlider(Input)
        end

        Items["MinDrag"]:Connect("InputBegan", function(Input)
            StartDragging(Input, "Min")
        end)

        Items["MaxDrag"]:Connect("InputBegan", function(Input)
            StartDragging(Input, "Max")
        end)

        Items["RealSlider"]:Connect("InputBegan", function(Input)
            StartDragging(Input)
        end)

        Library:Connect(UserInputService.InputChanged, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
                UpdateSlider(Input)
            end
        end)

        Library:Connect(UserInputService.InputEnded, function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                RangeSlider.Dragging = nil
            end
        end)

        RangeSlider:Set(RangeSlider.Default, RangeSlider.MaxDefault)

        Library.SetFlags[RangeSlider.Flag] = function(Value)
            RangeSlider:Set(Value)
        end

        return RangeSlider
    end

