    local function ResolveKey(Key)
        if Key == nil then
            return "None"
        end

        if typeof(Key) == "EnumItem" then
            local Name = Key.Name

            if Name == "Backspace" or Name == "Unknown" or Name == "Focus" then
                return "None"
            end

            return tostring(Key)
        end

        local Text = tostring(Key)

        Text = StringGSub(Text, "^Enum%.", "")
        Text = StringGSub(Text, "^KeyCode%.", "")
        Text = StringGSub(Text, "^UserInputType%.", "")

        if Text == "" or Text == "None" or Text == "Backspace" or Text == "Unknown" then
            return "None"
        end

        local Names = { Text, Text:upper(), Text:sub(1, 1):upper() .. Text:sub(2) }

        for Index, Name in Names do
            local Success, Item = pcall(function()
                return Enum.KeyCode[Name]
            end)

            if Success and Item then
                return tostring(Item)
            end
        end

        for Index, Name in Names do
            local Success, Item = pcall(function()
                return Enum.UserInputType[Name]
            end)

            if Success and Item then
                return tostring(Item)
            end
        end

        return "None"
    end

    local function DisplayKey(Key)
        if not Key or Key == "None" then
            return "None"
        end

        local Text = StringGSub(tostring(Key), "^Enum%.KeyCode%.", "")
        Text = StringGSub(Text, "^Enum%.UserInputType%.", "")

        return Keys[Text] or Text
    end

