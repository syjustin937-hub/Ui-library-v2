    local function UpdateGlow()
        Items["Shadow"]:Tween(TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            ImageTransparency = (Slider.Sliding or Hovering) and 0.3 or 1
        })
    end

    function Slider:Get()
        return Slider.Value
    end

    function Slider:Set(Value)
        Slider.Value = MathClamp(Library:Round(Value, Slider.Decimals), Slider.Min, Slider.Max)
        Library.Flags[Slider.Flag] = Slider.Value

        local Range = Slider.Max - Slider.Min
        local FillScale = Range ~= 0 and (Slider.Value - Slider.Min) / Range or 0

        Items["Accent"]:Tween(TweenInfo.new(0.1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2New(FillScale, 0, 1, 0)
        })

        Items["Drag"]:Tween(TweenInfo.new(0.1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2New(FillScale, 0, 0.5, 0)
        })

        Items["Value"].Instance.Text = StringFormat("%s%s", tostring(Slider.Value), Slider.Suffix)

        if Slider.Callback then 
            Library:SafeCall(Slider.Callback, Slider.Value)
        end
    end

    function Slider:SetVisibility(Bool)
        Items["Slider"].Instance.Visible = Bool
    end

    local function GetSliderValue(Input)
        local RelativeX = Input.Position.X - Items["RealSlider"].Instance.AbsolutePosition.X
        local SizeX = MathClamp(RelativeX / Items["RealSlider"].Instance.AbsoluteSize.X, 0, 1)
        return ((Slider.Max - Slider.Min) * SizeX) + Slider.Min
    end

    local function UpdateSlider(Input)
        if not Slider.Sliding then
            return
        end

        local Value = GetSliderValue(Input)
        Slider:Set(MathClamp(Library:Round(Value, Slider.Decimals), Slider.Min, Slider.Max))
    end

    local function StartSliding(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        Slider.Sliding = true
        UpdateGlow()
        UpdateSlider(Input)
    end

    local function StopSliding(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 and Input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        Slider.Sliding = false
        UpdateGlow()
    end

    Items["Drag"]:Connect("InputBegan", StartSliding)
    Items["RealSlider"]:Connect("InputBegan", StartSliding)
    Items["Drag"]:Connect("InputEnded", StopSliding)
    Items["RealSlider"]:Connect("InputEnded", StopSliding)

    Items["Drag"]:Connect("MouseEnter", function()
        Hovering = true
        UpdateGlow()
    end)

    Items["Drag"]:Connect("MouseLeave", function()
        Hovering = false
        UpdateGlow()
    end)

    Items["RealSlider"]:Connect("MouseEnter", function()
        Hovering = true
        UpdateGlow()
    end)

    Items["RealSlider"]:Connect("MouseLeave", function()
        Hovering = false
        UpdateGlow()
    end)

    Library:Connect(UserInputService.InputChanged, function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
            UpdateSlider(Input)
        end
    end)

    Library:Connect(UserInputService.InputEnded, function(Input)
        StopSliding(Input)
    end)

    if Slider.Default then
        Slider:Set(Slider.Default)
    end

    Library.SetFlags[Slider.Flag] = function(Value)
        Slider:Set(Value)
    end

    return Slider
end

end

